{
  "name": "tmux-session",
  "description": "Terminal session management via tmux \u2014 create, monitor, and control detached terminal sessions",
  "version": "1.0.1",
  "author": {
    "name": "GRAV LLC",
    "url": "https://github.com/softwaresoftware-dev"
  },
  "repository": "https://github.com/softwaresoftware-dev/tmux-session",
  "keywords": [
    "tmux",
    "terminal",
    "session",
    "provider"
  ],
  "mcpServers": {
    "tmux-session": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "server.py"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
